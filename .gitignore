# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# explicit private/local build exclusions
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
node_modules
.next
dist
build

# vercel
.vercel

/dist/
/.sites-artifacts/
/.wrangler/
/outputs/
/work/
/Portfolio/
/.sites-source/
/.codex-tmp/
*.tsbuildinfo
